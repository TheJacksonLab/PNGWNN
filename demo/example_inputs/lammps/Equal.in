write_data      final2.data

reset_timestep  0

undump          1

dump            2 all atom 1000 DVOCB2.lammpstrj
dump_modify     2 scale no
dump_modify     2 sort id

fix             1 all npt temp 300.0 300.0 100 iso 1 1 1000
velocity        all scale 300
run             1000000
write_data      final2.data
run             1000000
write_data      final2.data
