fix             1 all npt temp 300.0 300.0 100 iso 25000 25000 100
velocity        all scale 300
run             5000
unfix           1

#13
fix             1 all nvt temp 800.0 800.0 100
velocity        all scale 800
run             5000
unfix           1

#14
fix             1 all nvt temp 300.0 300.0 100
velocity        all scale 300
run             10000
unfix           1

